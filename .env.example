NODE_ENV=development
PORT=3001
# Stripe Checkout 完成或取消後返回的單一前端 origin；production 不可使用 localhost
FRONTEND_ORIGIN=http://localhost:5173
# CORS allowlist，支援 comma-separated origins；未設定時沿用 FRONTEND_ORIGIN
CORS_ORIGINS=http://localhost:5173
# DATABASE_URL：從 Supabase Dashboard → Connect（或 Settings → Database → Connection string）複製，
# 並把 [YOUR-PASSWORD] 換成 Database password（忘了就 Settings → Database → Reset）。
# 跑 migrate / 腳本要用「session 級」連線；勿用 Transaction pooler(6543)，它不支援 migration。
#   ① Direct（首選）       host db.<ref>.supabase.co        port 5432  → 但 IPv6-only，部分網路連不到
#   ② Session pooler（備用）host <region>.pooler.supabase.com port 5432  → IPv4 相容，Direct 連不到時用這個
# 範例（本機 Postgres）：
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/asterism?schema=public"   

# enrich 抓圖管線用（npm run enrich:images）
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# 後端 API 的 Supabase Auth token 驗證
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Stripe Checkout - 僅限伺服器端
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONSULTATION_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_PATH=/consultant?payment=success
STRIPE_CHECKOUT_CANCEL_PATH=/consultant?payment=cancel
