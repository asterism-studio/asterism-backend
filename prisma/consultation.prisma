enum ConsultationMethod {
  online
  in_person
}

enum ConsultationTimeSlot {
  am
  pm
}

enum ConsultationBookingStatus {
  pending_payment
  confirmed
  payment_failed
  canceled
  completed
}

model ConsultationBooking {
  id                String                    @id @default(uuid()) @db.Uuid
  profileId         String                    @map("profile_id") @db.Uuid
  sourceImageId     String?                   @map("source_image_id") @db.Text
  method            ConsultationMethod
  consultationDate  DateTime                  @map("consultation_date") @db.Date
  timeSlot          ConsultationTimeSlot      @map("time_slot")
  timezone          String                    @default("Asia/Taipei") @db.Text
  designField       String?                   @map("design_field") @db.Text
  designFocus       String?                   @map("design_focus") @db.Text
  contactName       String?                   @map("contact_name") @db.Text
  contactEmail      String                    @map("contact_email") @db.Text
  notes             String?                   @db.Text
  depositAcceptedAt DateTime                  @map("deposit_accepted_at") @db.Timestamptz(6)
  status            ConsultationBookingStatus @default(pending_payment)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)

  profile     Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  sourceImage Image?  @relation(fields: [sourceImageId], references: [id], onDelete: SetNull)

  @@index([profileId])
  @@index([sourceImageId])
  @@map("consultation_bookings")
}
